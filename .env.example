# Server URL for API calls
NEXT_BACKEND_URL=
# Whether mock backend is enabled
MOCK_ENABLED=false

# Backend API URL
API_URL=http://localhost:8000

# Used to configure CORS, format links and more. No trailing slash
# In production, this should be the URL of the server. (Should not need to specify port)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Server only (never NEXT_PUBLIC_). Must equal the backend's AUTH_PROXY_SECRET. The proxy sends it with
# the browser's address so the backend's login/signup rate limits count real clients. Rollout: deploy
# this frontend with the secret set first, then set the backend's, then deploy the backend. Empty = not sent.
AUTH_PROXY_SECRET=

# Preferred code editor for opening files from the dashboard
REACT_EDITOR=code
